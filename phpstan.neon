# Level 1 is the enforced floor: it is what the codebase passes cleanly today, so CI
# stays meaningful rather than permanently red. Raising it is 1.14.0-beta.1 work —
# see docs/ROADMAP.md. Current counts, for the ratchet:
#
#   level 2 — 24 errors
#   level 3 — 66
#   level 5 — 121 in src (mostly generics and @readonly-outside-constructor)
#
# No baseline file by design: errors get fixed, not recorded.
parameters:
    level: 1
    paths:
        - src
        - tests
    treatPhpDocTypesAsCertain: false
