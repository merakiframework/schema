# Static analysis of the shipped code. Tests are analysed separately, at a lower level,
# by phpstan-tests.neon — see the note there.
#
# Level 2 is what src passes cleanly today. The remaining cost of going higher, measured:
#
#   level 3 —   2 errors
#   level 4 —  19
#   level 5 —  24
#   level 6 — 132
#
# Several of those are worth fixing on their own merits rather than for the level: dead
# null comparisons in Composite, and Atomic::validate() declaring a narrower return type
# than it produces. Raising this is tracked in docs/ROADMAP.md.
#
# No baseline file by design: errors get fixed, not recorded.
parameters:
    level: 2
    paths:
        - src
    treatPhpDocTypesAsCertain: false
